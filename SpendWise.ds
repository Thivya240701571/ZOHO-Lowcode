		workflow
		{
		form
		{
			Budget_Alert_Workflow as "Budget Alert Workflow"
			{
				type =  form
				form = Expenses

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Emails every new expense, and flags a large one. Budget levels are in Budget_Refresh.
										subject = "SpendWise: new expense of Rs. " + input.Amount;
										if(input.Amount >= 5000)
										{
											subject = "SpendWise alert: large expense of Rs. " + input.Amount;
										}
										// Zoho caps emails per day, and a failed email mustn't stop the save.
										try 
										{
											sendmail
											[
												from :zoho.adminuserid
												to :zoho.adminuserid
												subject :subject
												message :"<b>" + input.Expense_Name + "</b>: Rs. " + input.Amount + " on " + input.Category + ", paid by " + input.Payment_Method + " (" + input.Date_field + ").<br><br>Check your budget on the SpendWise dashboard.<br><br>SpendWise"
											]
										}catch (e)
										{
											info e;
										}
						)
					}
				}

			}
			Expense_Validate as "Expense - check the amount and note its month"
			{
				type =  form
				form = Expenses

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Amount <= 0)
										{
											alert "Amount spent must be more than 0.";
											cancel submit;
										}
										input.Budget_Month = input.Date_field.toString("MMMM yyyy");
						)
					}
				}

			}
			Budget_Refresh as "Budget Refresh - recalculate budgets and send alerts"
			{
				type =  form
				form = Expenses

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Recalculates every month's budget from its expenses, so an expense moved to another month is
										// counted correctly too. Emails only when a budget moves up a level: first at its alert threshold,
										// then at 100%.
										for each  b in Monthly_Budget[ID != 0]
										{
											spent = ifnull(Expenses[Budget_Month == b.Month_Key].sum(Amount),0);
											used = (spent * 100 / b.Budget_Amount).round(1);
											status = "On Track";
											if(used >= 100)
											{
												status = "Over Budget";
											}
											else if(used >= ifnull(b.Alert_Threshold,80))
											{
												status = "Near Limit";
											}
											if(status == "Over Budget" && b.Budget_Status != "Over Budget" || status == "Near Limit" && b.Budget_Status == "On Track")
											{
												// Zoho caps emails per day, and a failed email mustn't stop the save.
												try 
												{
													sendmail
													[
														from :zoho.adminuserid
														to :zoho.adminuserid
														subject :"SpendWise: " + b.Month_Key + " budget is " + used + "% used"
														message :"You have spent <b>Rs. " + spent + "</b> of your <b>Rs. " + b.Budget_Amount + "</b> budget for " + b.Month_Key + " (" + used + "%). Status: <b>" + status + "</b>.<br><br>SpendWise"
													]
												}		catch (e)
												{
													info e;
												}
											}
											b.Spent_Amount=spent;
											b.Remaining_Amount=b.Budget_Amount - spent;
											b.Used_Percent=used;
											b.Budget_Status=status;
										}
						)
					}
				}

			}
			Expense_Deleted as "Expense deleted - recalculate its month"
			{
				type =  form
				form = Expenses

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Spending only goes down here, so no alert is needed.
										for each  b in Monthly_Budget[Month_Key == input.Budget_Month]
										{
											spent = ifnull(Expenses[Budget_Month == b.Month_Key].sum(Amount),0);
											used = (spent * 100 / b.Budget_Amount).round(1);
											status = "On Track";
											if(used >= 100)
											{
												status = "Over Budget";
											}
											else if(used >= ifnull(b.Alert_Threshold,80))
											{
												status = "Near Limit";
											}
											b.Spent_Amount=spent;
											b.Remaining_Amount=b.Budget_Amount - spent;
											b.Used_Percent=used;
											b.Budget_Status=status;
										}
						)
					}
				}

			}
			Expense_Form_Load as "Expense - default date and hidden month"
			{
				type =  form
				form = Expenses

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											hide Budget_Month;
										if(input.Date_field == null)
										{
											input.Date_field = zoho.currenttime;
										}
						)
					}
				}

			}
			Income_Validate as "Income - check the amount"
			{
				type =  form
				form = Income

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Amount <= 0)
										{
											alert "Amount must be more than 0.";
											cancel submit;
										}
						)
					}
				}

			}
			Budget_Form_Load as "Budget - default threshold and read-only fields"
			{
				type =  form
				form = Monthly_Budget

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											hide Month_Key;
										disable Spent_Amount;
										disable Remaining_Amount;
										disable Used_Percent;
										disable Budget_Status;
										if(input.Alert_Threshold == null)
										{
											input.Alert_Threshold = 80;
										}
						)
					}
				}

			}
			Budget_Validate as "Budget - one per month, and work out what is used"
			{
				type =  form
				form = Monthly_Budget

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											error = "";
										key = input.Month_field + " " + input.Year_field;
										for each  b in Monthly_Budget[Month_Key == key]
										{
											if(b.ID != input.ID)
											{
												error = "A budget for " + key + " already exists. Edit that one instead.";
											}
										}
										if(input.Budget_Amount <= 0)
										{
											error = "Budget amount must be more than 0.";
										}
										else if(input.Year_field < 2000 || input.Year_field > 2100)
										{
											error = "Enter a four-digit year, such as 2026.";
										}
										else if(ifnull(input.Alert_Threshold,80) <= 0 || ifnull(input.Alert_Threshold,80) > 100)
										{
											error = "Alert threshold must be between 1 and 100.";
										}
										if(error != "")
										{
											alert error;
											cancel submit;
										}
										input.Month_Key = key;
										spent = ifnull(Expenses[Budget_Month == key].sum(Amount),0);
										input.Spent_Amount = spent;
										input.Remaining_Amount = input.Budget_Amount - spent;
										input.Used_Percent = (spent * 100 / input.Budget_Amount).round(1);
										if(input.Used_Percent >= 100)
										{
											input.Budget_Status = "Over Budget";
										}
										else if(input.Used_Percent >= ifnull(input.Alert_Threshold,80))
										{
											input.Budget_Status = "Near Limit";
										}
										else
										{
											input.Budget_Status = "On Track";
										}
						)
					}
				}

			}
			Goal_Check as "Goal - track progress and email when it is completed"
			{
				type =  form
				form = Savings_Goal

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Target_Amount <= 0)
										{
											alert "Target amount must be more than 0.";
											cancel submit;
										}
										saved = ifnull(input.Current_Saved_Amount,0);
										input.Progress_Percent = (saved * 100 / input.Target_Amount).round(1);
										if(saved >= input.Target_Amount)
										{
											input.Goat_Status = "Achieved";
											// Completed_On is set once, so editing a finished goal doesn't email again.
											if(input.Completed_On == null)
											{
												input.Completed_On = zoho.currentdate;
												// Zoho caps emails per day, and a failed email mustn't stop the save.
												try 
												{
													sendmail
													[
														from :zoho.adminuserid
														to :zoho.adminuserid
														subject :"SpendWise: you completed your goal " + input.Goal_Name
														message :"You have saved <b>Rs. " + saved + "</b> and reached your target of <b>Rs. " + input.Target_Amount + "</b> for <b>" + input.Goal_Name + "</b>. Well done!<br><br>SpendWise"
													]
												}		catch (e)
												{
													info e;
												}
											}
										}
										else
										{
											input.Completed_On = null;
											if(input.Goat_Status == null || input.Goat_Status == "" || input.Goat_Status == "Achieved")
											{
												input.Goat_Status = "In Progress";
											}
										}
						)
					}
				}

			}
			Goal_Form_Load as "Goal - read-only fields"
			{
				type =  form
				form = Savings_Goal

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											disable Progress_Percent;
										disable Completed_On;
						)
					}
				}

			}
		}






	}
