 application "SpendWise"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Expenses
		{
			success message = "Expense Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Expense_Name
			(
    			type = text
				displayname = "Expense Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Amount
			(
				displayname = "Amount Spent"
				type = INR
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Date_field
			(
    			type = datetime
				displayname = "Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Category
			(
				type = picklist
				maxchar = 100
				values = {"Food","Travel","Shopping","Education","Bills","Health","Entertainment","Others"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Payment_Method
			(
				type = picklist
				displayname = "Payment Method"
				maxchar = 100
				values = {"Cash","UPI","Debit/Credit Card","Bank Transfer","Others"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Budget_Month
			(
    			type = text
				displayname = "Budget Month"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Amount_Spent_Prediction
			(
				type = decimal
				displayname = "Amount Spent Prediction"
	 			row = 1
	 			column = 1   
				width = medium
						AI_Properties
						(
									fieldtype = Prediction
									modelname = "SpendWise_Expense_Prediction"
									supportingfield = {Category,Payment_Method,Date_field}
						)
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Income
		{
			success message = "Income Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Income_Source
			(
    			type = text
				displayname = "Income Source"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Amount
			(
				type = INR
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Date_field
			(
    			type = datetime
				displayname = "Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Income_Category
			(
				type = picklist
				displayname = "Income Category"
				maxchar = 100
				values = {"Salary","Pocket Money","Freelance","Business","Gifts","Investments","Others"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Monthly_Budget
		{
			displayname = "Monthly Budget"
			success message = "Monthly Budget Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Budget_Line
			(
    			type = text
				displayname = "Budget Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Month_field
			(
				type = picklist
				displayname = "Month"
				maxchar = 100
				values = {"January","February","March","April","May","June","July","August","September","October","November","December"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Year_field
			(
				type = number
				displayname = "Year"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Budget_Amount
			(
				displayname = "Budget Amount"
				type = INR
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			Alert_Threshold
			(
				type = number
				displayname = "Alert Threshold (%)"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Month_Key
			(
    			type = text
				displayname = "Month Key"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Spent_Amount
			(
				displayname = "Spent"
				type = INR
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			Remaining_Amount
			(
				displayname = "Remaining"
				type = INR
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			Used_Percent
			(
				type = decimal
				displayname = "Used (%)"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Budget_Status
			(
				type = picklist
				displayname = "Status"
				maxchar = 100
				values = {"On Track","Near Limit","Over Budget"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Savings_Goal
		{
			displayname = "Savings Goal"
			success message = "Savings Goal Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Goal_Name
			(
    			type = text
				displayname = "Goal Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Target_Amount
			(
				displayname = "Target Amount"
				type = INR
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			Current_Saved_Amount
			(
				displayname = "Current Saved Amount"
				type = INR
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Date_field
			(
    			type = datetime
				displayname = "Target Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Goat_Status
			(
				type = picklist
				displayname = "Goal Status"
				maxchar = 100
				values = {"In Progress","Achieved","Paused"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Progress_Percent
			(
				type = decimal
				displayname = "Progress (%)"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Completed_On
			(
    			type = date
				displayname = "Completed On"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list All_Expenses
		{
			displayName = "All Expenses"
			show all rows from Expenses    
			(
				Expense_Name as "Expense Name"
				Amount as "Amount Spent"
				Date_field as "Date"
				Category
				Payment_Method as "Payment Method"
				Notes
				Amount_Spent_Prediction as "Amount Spent Prediction"
			)
		}
		default list All_Incomes
		{
			displayName = "All Incomes"
			show all rows from Income    
			(
				Income_Source as "Income Source"
				Amount as "Amount "
				Date_field as "Date  "
				Income_Category as "Income Category"
			)
		}
		default list All_Monthly_Budgets
		{
			displayName = "All Monthly Budgets"
			show all rows from Monthly_Budget    
			(
				Budget_Line as "Budget Name"
				Month_field as "Month"
				Year_field as "Year"
				Budget_Amount as "Budget Amount"
				Alert_Threshold as "Alert Threshold (%)"
				Spent_Amount as "Spent"
				Remaining_Amount as "Remaining"
				Used_Percent as "Used (%)"
				Budget_Status as "Status"
			)
		}
		default list All_Savings_Goals
		{
			displayName = "All Savings Goals"
			show all rows from Savings_Goal    
			(
				Goal_Name as "Goal Name"
				Target_Amount as "Target Amount"
				Current_Saved_Amount as "Current Saved Amount"
				Date_field as "Target Date"
				Goat_Status as "Goal Status"
				Progress_Percent as "Progress (%)"
				Completed_On as "Completed On"
			)
		}
		list Expenses_History
		{
			displayName = "Expenses History"
			show all rows from Expenses    
			(
				Expense_Name as "Expense Name"
				Date_field as "Date"
				Category
				Amount as "Amount Spent"
				Payment_Method as "Payment Method"
				Notes
			)
			filters
			(
				Date_field
				Category
				Payment_Method
			)
			sort by
			(
				Date_field descending
			)
		}
		list Savings_Goals_Overview
		{
			displayName = "Savings Goals Overview"
			show all rows from Savings_Goal    
			(
				Goal_Name as "Goal Name"
				Target_Amount as "Target Amount"
				Current_Saved_Amount as "Current Saved Amount"
				Date_field as "Date"
				Goat_Status as "Goal Status"
			)
			filters
			(
				Goat_Status
			)
			sort by
			(
				Date_field descending
			)
		}
		list Monthly_Budget_Overview
		{
			displayName = "Monthly Budget Overview"
			show all rows from Monthly_Budget    
			(
				Budget_Line as "Budget Name"
				Month_field as "Month"
				Year_field as "Year"
				Budget_Amount as "Budget Amount"
				Alert_Threshold as "Alert Threshold"
			)
			filters
			(
				Month_field
				Year_field
			)
			sort by
			(
				Year_field descending
				Month_field ascending
			)
		}
		list Income_History
		{
			displayName = "Income History"
			show all rows from Income    
			(
				Income_Source as "Income Source"
				Date_field as "Date"
				Income_Category as "Income Category"
				Amount
			)
			filters
			(
				Date_field
				Income_Category
			)
			sort by
			(
				Date_field descending
			)
		}
	}
